
conky.config = {
    alignment = 'top_right',
    background = true,
    double_buffer = true,
    default_color = '#24292e',
    draw_borders = false,
    draw_outline = false,
    draw_shades = false,
    use_xft = true,
    font = 'JetBrains Mono:pixelsize=14',
    gap_x = 12,
    gap_y = 6,
    out_to_x = true,
    own_window = false,
    update_interval = 3,
    uppercase = false,
}

conky.text = [[
${time %a %d %b %H:%M}   \
${if_match "${exec ifconfig iwm0 | grep status | awk '{print $2}'}" == "active"}\
${exec ifconfig iwm0 | grep ieee80211 | awk '{print $3}'}   ${endif}\
${memeasyfree}   \
${exec apm -l}%
]];
